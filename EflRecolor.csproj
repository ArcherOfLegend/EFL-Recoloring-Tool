<Project Sdk="Microsoft.NET.Sdk">
 
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>EflRecolor</AssemblyName>
    <RootNamespace>EflRecolor</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>efl_editor_logo.ico</ApplicationIcon>
 
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
 
    <Version>1.1.0</Version>
    <Product>EFL Recolor</Product>
    <Company>ArcherOfLegend</Company>
    <Description>Recolours UMvC3 MT Framework .efl effect files</Description>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="efl_editor_logo.ico" LogicalName="app.ico" />
  </ItemGroup>
 

</Project>
